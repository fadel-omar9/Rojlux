<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"] — Roj Lux ASBL</title>
  <meta name="description" content="@ViewData["Description"]">
  <meta name="keywords" content="Roj Lux, ASBL, Kurdistan, Luxemburg, Kultur, Integration, Newroz, Verein">
  <meta property="og:title" content="@ViewData["Title"] — Roj Lux ASBL">
  <meta property="og:description" content="@ViewData["Description"]">
  <meta property="og:image" content="/images/logo.jpg">
  <meta property="og:type" content="website">
  <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
  <link rel="stylesheet" href="~/css/style.css">
  <link rel="stylesheet" href="~/css/components.css">
  <link rel="stylesheet" href="~/css/responsive.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  @await RenderSectionAsync("Styles", required: false)
</head>
<body>

  <!-- Navigation -->
  <nav class="navbar" id="navbar">
    <div class="container">
      <a asp-page="/Index" class="nav-logo">
        <img src="~/images/logo.jpg" alt="Roj Lux Logo">
        <div class="nav-logo-text">
          <span class="nav-logo-name">Roj Lux</span>
          <span class="nav-logo-sub">ASBL Luxembourg</span>
        </div>
      </a>

      <div class="nav-menu" id="nav-menu">
        <a asp-page="/Index" class="nav-link">@SharedLocalizer["Startseite"]</a>
        <a asp-page="/UeberUns" class="nav-link">@SharedLocalizer["Über uns"]</a>
        <a asp-page="/Veranstaltungen" class="nav-link">@SharedLocalizer["Veranstaltungen"]</a>
        <a asp-page="/Galerie" class="nav-link">@SharedLocalizer["Galerie"]</a>
        <a asp-page="/Kontakt" class="nav-link">@SharedLocalizer["Kontakt"]</a>
        <div class="nav-cta">
          <a asp-page="/MitgliedWerden" class="btn btn-primary btn-sm">@SharedLocalizer["Mitglied werden"]</a>
        </div>
        <div class="nav-lang">
          <a href="?culture=de" class="nav-link">DE</a> | 
          <a href="?culture=fr" class="nav-link">FR</a>
        </div>
      </div>

      <div class="nav-hamburger" id="nav-hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
    <div class="nav-overlay" id="nav-overlay"></div>
  </nav>

  <!-- Page Content -->
  @RenderBody()

  <!-- Footer -->
  <footer class="footer" id="footer">
    <div class="tricolor-bar"></div>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a asp-page="/Index" class="nav-logo">
            <img src="~/images/logo.jpg" alt="Roj Lux Logo">
            <div class="nav-logo-text">
              <span class="nav-logo-name">Roj Lux</span>
              <span class="nav-logo-sub">ASBL Luxembourg</span>
            </div>
          </a>
          <p>Roj Lux ASBL — Société de la culture &amp; des Arts. Ein gemeinnütziger Verein zur Förderung der kurdischen Kultur und Integration in Luxemburg.</p>
          <div class="footer-social">
            <a href="https://www.facebook.com/ROJLUX.lu" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
            <a href="https://www.instagram.com/roj_lux" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
            <a href="https://www.youtube.com/@@kurd-lux6934" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
            <a href="https://www.tiktok.com/@@rojlux.a.s.b.l" target="_blank" rel="noopener noreferrer" aria-label="TikTok"><i class="fab fa-tiktok"></i></a>
            <a href="mailto:rojlux1@gmail.com" aria-label="E-Mail"><i class="fas fa-envelope"></i></a>
          </div>
        </div>

        <div>
          <h4>Navigation</h4>
          <div class="footer-links">
            <a asp-page="/Index">Startseite</a>
            <a asp-page="/UeberUns">Über uns</a>
            <a asp-page="/Veranstaltungen">Veranstaltungen</a>
            <a asp-page="/Galerie">Galerie</a>
            <a asp-page="/MitgliedWerden">Mitglied werden</a>
            <a asp-page="/Kontakt">Kontakt</a>
          </div>
        </div>

        <div>
          <h4>Rechtliches</h4>
          <div class="footer-links">
            <a asp-page="/Datenschutz">Datenschutz</a>
            <a asp-page="/Impressum">Impressum</a>
            <a href="/documents/statuts%20coordonn%C3%A9s.pdf" target="_blank">Statuten (PDF)</a>
          </div>
        </div>

        <div>
          <h4>Kontakt</h4>
          <div class="footer-contact-item">
            <span class="icon"><i class="fas fa-map-marker-alt"></i></span>
            <span>5, rue Johannes Kepler<br>L-1873 Luxembourg</span>
          </div>
          <div class="footer-contact-item">
            <span class="icon"><i class="fas fa-envelope"></i></span>
            <span>rojlux1@gmail.com</span>
          </div>
          <div class="footer-contact-item">
            <span class="icon">📘</span>
            <a href="https://www.facebook.com/ROJLUX.lu" target="_blank" rel="noopener noreferrer">Facebook</a>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; 2024–@DateTime.Now.Year Roj Lux ASBL. Alle Rechte vorbehalten.</p>
        <div class="footer-legal">
          <a asp-page="/Datenschutz">Datenschutz</a>
          <a asp-page="/Impressum">Impressum</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Cookie Banner -->
  <div class="cookie-banner" id="cookie-banner">
    <div class="container">
      <p>Wir verwenden Cookies, um Ihr Erlebnis auf unserer Website zu verbessern. Weitere Informationen finden Sie in unserer <a asp-page="/Datenschutz">Datenschutzerklärung</a>.</p>
      <div class="cookie-buttons">
        <button class="btn btn-primary btn-sm" id="cookie-accept">Akzeptieren</button>
        <button class="btn btn-sm" id="cookie-decline" style="background: rgba(255,255,255,0.1); color: var(--color-gray-200);">Ablehnen</button>
      </div>
    </div>
  </div>

  <!-- Back to Top -->
  <button class="back-to-top" id="back-to-top" aria-label="Nach oben scrollen">↑</button>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" aria-label="Schließen">✕</button>
    <button class="lightbox-nav lightbox-prev" aria-label="Vorheriges Bild">❮</button>
    <div class="lightbox-content">
      <img id="lightbox-img" src="" alt="">
    </div>
    <button class="lightbox-nav lightbox-next" aria-label="Nächstes Bild">❯</button>
  </div>

  <script src="~/js/main.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
