@page
@model RojLuxWeb.Pages.IndexModel
@{
    ViewData["Title"] = "Kurdische Kultur & Integration in Luxemburg";
    ViewData["Description"] = "Roj Lux ASBL ist ein gemeinnütziger Verein in Luxemburg, der sich für die Förderung der kurdischen Kultur, Integration und Gemeinschaft einsetzt.";
}
</section>

<!-- Digitale Uhr -->
<div style="text-align:center; font-size:40px; font-weight:bold; margin:20px 0;">
    <div id="uhr"></div>
</div>

<script>
    function updateClock() {
        const now = new Date();
        const timeString = now.toLocaleTimeString('de-DE', { hour12: false });
        document.getElementById("uhr").innerText = timeString;
    }

    setInterval(updateClock, 1000);
    updateClock();
</script>

<!-- Tricolor Accent -->
<div class="tricolor-bar"></div>

<!-- Hero Section -->
<section class="hero" id="hero">
  <div class="hero-bg">
    <img src="~/images/veranstaltungen.jpg" alt="Roj Lux Newroz Fest in Luxemburg">
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <img src="~/images/logo.jpg" alt="Roj Lux ASBL Logo" class="hero-logo">
    <h1>
      Roj Lux ASBL
      <span>Société de la culture &amp; des Arts</span>
    </h1>
    <p class="hero-description">
      Wir fördern die kurdische Kultur, stärken die Integration und bauen Brücken zwischen der kurdischen Gemeinschaft und Luxemburg.
    </p>
    <div class="hero-buttons">
      <a asp-page="/UeberUns" class="btn btn-primary btn-lg">Mehr erfahren</a>
      <a asp-page="/MitgliedWerden" class="btn btn-secondary btn-lg">Mitglied werden</a>
    </div>
  </div>
  <div class="hero-scroll-indicator">
    <a href="#ueber">
      <span>Entdecken</span>
      <div class="scroll-arrow"></div>
    </a>
  </div>
</section>

<!-- Tricolor Accent -->
<div class="tricolor-bar"></div>

<!-- About Preview Section -->
<section class="section" id="ueber">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <span class="section-badge">☀️ Über uns</span>
      <h2>Unsere Mission</h2>
      <div class="sun-divider"><span class="sun-icon">☀️</span></div>
      <p>Roj Lux ASBL setzt sich für die Förderung der kurdischen Kultur und die Integration der kurdischen Gemeinschaft in Luxemburg ein.</p>
    </div>

    <div class="grid-3">
      <div class="feature-card animate-on-scroll animate-delay-1">
        <div class="feature-card-icon red">🎭</div>
        <h3>Kultur bewahren</h3>
        <p>Wir pflegen und fördern die kurdische Kultur, Traditionen und Sprache – damit unsere Wurzeln lebendig bleiben.</p>
      </div>
      <div class="feature-card animate-on-scroll animate-delay-2">
        <div class="feature-card-icon green">🤝</div>
        <h3>Integration fördern</h3>
        <p>Wir unterstützen die Integration der kurdischen Gemeinschaft in die luxemburgische Gesellschaft durch Dialog und Teilhabe.</p>
      </div>
      <div class="feature-card animate-on-scroll animate-delay-3">
        <div class="feature-card-icon gold">👨‍👩‍👧‍👦</div>
        <h3>Gemeinschaft stärken</h3>
        <p>Durch soziale und kulturelle Aktivitäten schaffen wir Raum für Begegnung, Austausch und Zusammenhalt.</p>
      </div>
    </div>

    <div class="text-center mt-2xl animate-on-scroll">
      <a asp-page="/UeberUns" class="btn btn-outline">Mehr über uns erfahren →</a>
    </div>
  </div>
</section>

<!-- Stats Section -->
<section class="section section-dark">
  <div class="container">
    <div class="stats-section">
      <div class="stat-item animate-on-scroll">
        <div class="stat-number" data-count="2024" data-suffix="">2024</div>
        <div class="stat-label">Gegründet</div>
      </div>
      <div class="stat-item animate-on-scroll animate-delay-1">
        <div class="stat-number" data-count="50" data-suffix="+">0</div>
        <div class="stat-label">Mitglieder</div>
      </div>
      <div class="stat-item animate-on-scroll animate-delay-2">
        <div class="stat-number" data-count="10" data-suffix="+">0</div>
        <div class="stat-label">Veranstaltungen</div>
      </div>
      <div class="stat-item animate-on-scroll animate-delay-3">
        <div class="stat-number" data-count="1" data-suffix="">1</div>
        <div class="stat-label">Gemeinsame Vision</div>
      </div>
    </div>
  </div>
</section>

<!-- Events Preview -->
<section class="section section-light" id="events">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <span class="section-badge">📅 Veranstaltungen</span>
      <h2>Aktuelle Events</h2>
      <div class="sun-divider"><span class="sun-icon">☀️</span></div>
      <p>Entdecken Sie unsere kommenden Veranstaltungen und werden Sie Teil unserer lebendigen Gemeinschaft.</p>
    </div>

    <div class="grid-3">
      <div class="event-card animate-on-scroll animate-delay-1">
        <div class="event-card-image">
          <img src="~/images/veranstaltungen.jpg" alt="Newroz Fest 2026">
          <div class="event-card-date">
            <span class="day">21</span>
            <span class="month">Mär</span>
          </div>
          <span class="event-card-badge">Highlight</span>
        </div>
        <div class="event-card-body">
          <h3 class="event-card-title">Newroz-Fest 2026</h3>
          <div class="event-card-location">📍 Luxemburg</div>
          <p class="event-card-description">Feiern Sie mit uns das kurdische Neujahrsfest Newroz — ein Fest der Freude, des Frühlings und der Hoffnung. Mit Musik, Tanz und traditionellem Essen.</p>
          <a asp-page="/Veranstaltungen" class="btn btn-sm btn-outline">Details →</a>
        </div>
      </div>

      <div class="event-card animate-on-scroll animate-delay-2">
        <div class="event-card-image">
          <img src="~/images/hintergrunf.jpg" alt="Kultureller Abend">
          <div class="event-card-date">
            <span class="day">15</span>
            <span class="month">Mai</span>
          </div>
        </div>
        <div class="event-card-body">
          <h3 class="event-card-title">Kultureller Abend</h3>
          <div class="event-card-location">📍 Luxembourg-Stadt</div>
          <p class="event-card-description">Ein Abend voller kurdischer Kultur: Musik, Poesie und Geschichten. Eine Gelegenheit, die Vielfalt unserer Kultur zu erleben.</p>
          <a asp-page="/Veranstaltungen" class="btn btn-sm btn-outline">Details →</a>
        </div>
      </div>

      <div class="event-card animate-on-scroll animate-delay-3">
        <div class="event-card-image">
          <img src="~/images/hintergrunf.jpg" alt="Kurdisch-Kurs für Kinder">
          <div class="event-card-date">
            <span class="day">01</span>
            <span class="month">Jun</span>
          </div>
        </div>
        <div class="event-card-body">
          <h3 class="event-card-title">Kurdisch-Kurs für Kinder</h3>
          <div class="event-card-location">📍 Luxembourg</div>
          <p class="event-card-description">Spielerischer Sprachunterricht für Kinder — damit die kurdische Sprache und Kultur an die nächste Generation weitergegeben wird.</p>
          <a asp-page="/Veranstaltungen" class="btn btn-sm btn-outline">Details →</a>
        </div>
      </div>
    </div>

    <div class="text-center mt-2xl animate-on-scroll">
      <a asp-page="/Veranstaltungen" class="btn btn-gold">Alle Veranstaltungen →</a>
    </div>
  </div>
</section>

<!-- Gallery Preview -->
<section class="section">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <span class="section-badge">🖼️ Galerie</span>
      <h2>Eindrücke &amp; Momente</h2>
      <div class="sun-divider"><span class="sun-icon">☀️</span></div>
      <p>Bilder sagen mehr als Worte. Entdecken Sie Impressionen aus unserem Vereinsleben.</p>
    </div>

    <div class="gallery-grid">
      <div class="gallery-item animate-on-scroll animate-delay-1" data-category="kultur">
        <img src="~/images/bild (1).jpg" alt="Roj Lux Impression 1">
        <div class="gallery-item-overlay">
          <span>Roj Lux Impression</span>
        </div>
      </div>
      <div class="gallery-item animate-on-scroll animate-delay-2" data-category="gemeinschaft">
        <img src="~/images/bild (2).jpg" alt="Roj Lux Impression 2">
        <div class="gallery-item-overlay">
          <span>Unsere Gemeinschaft</span>
        </div>
      </div>
      <div class="gallery-item animate-on-scroll animate-delay-3" data-category="kinder">
        <img src="~/images/bild (3).jpg" alt="Roj Lux Impression 3">
        <div class="gallery-item-overlay">
          <span>Vereinsleben</span>
        </div>
      </div>
    </div>

    <div class="text-center mt-2xl animate-on-scroll">
      <a asp-page="/Galerie" class="btn btn-outline">Zur Galerie →</a>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="cta-section">
  <div class="container">
    <div class="cta-content animate-on-scroll">
      <h2>Werden Sie Teil unserer Gemeinschaft</h2>
      <p>Unterstützen Sie die kurdische Kultur in Luxemburg. Treten Sie Roj Lux ASBL bei und helfen Sie uns, Brücken zu bauen.</p>
      <div class="flex-center gap-lg" style="flex-wrap: wrap;">
        <a asp-page="/MitgliedWerden" class="btn btn-primary btn-lg">Mitglied werden</a>
        <a asp-page="/Kontakt" class="btn btn-secondary btn-lg">Kontakt aufnehmen</a>
      </div>
    </div>
  </div>
</section>

<!-- Social Media Section -->
<section class="section section-light">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <span class="section-badge">🌐 Social Media</span>
      <h2>Folgen Sie uns</h2>
      <div class="sun-divider"><span class="sun-icon">☀️</span></div>
      <p>Bleiben Sie auf dem Laufenden über unsere Aktivitäten auf Facebook.</p>
    </div>

    <div class="social-embed animate-on-scroll">
      <div class="fb-page-container">
        <iframe src="https://www.facebook.com/plugins/page.php?href=https%3A%2F%2Fwww.facebook.com%2FROJLUX.lu&tabs=timeline&width=500&height=600&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true" 
          width="500" height="600" style="border:none;overflow:hidden" scrolling="no" frameborder="0" 
          allowfullscreen="true" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
          loading="lazy"
          title="Roj Lux Facebook">
        </iframe>
      </div>
    </div>
  </div>
</section>

@section Scripts {
  <script src="~/js/gallery.js"></script>
}
